<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Tunnelka.Next.Controls"
        x:Class="Tunnelka.Next.MainWindow"
        Title="Tunnelka"
        Icon="/Assets/tunnelka.ico"
        Width="1233" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <LayoutTransformControl x:Name="Scaler">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="68" />
        <ColumnDefinition Width="0.4*" MinWidth="440" MaxWidth="600" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="12,18,12,0">
            <controls:LogoMark Width="44" Height="44" />
            <Button x:Name="AddButton" Classes="nav" Margin="0,22,0,0"></Button>
            <Border Height="2" Margin="8,4" Background="{DynamicResource BorderBrush2}" />
            <Button x:Name="ServersButton" Classes="nav active"></Button>
            <Button x:Name="StatsButton" Classes="nav"></Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="12,0,12,18" VerticalAlignment="Bottom">
            <Button x:Name="AboutButton" Classes="nav"></Button>
            <Button x:Name="SettingsButton" Classes="nav"></Button>
          </StackPanel>
          <Panel />
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Padding="20,20,20,16">
        <Panel x:Name="PagesHost" />
      </Border>

      <Panel x:Name="HeroHost" Grid.Column="2" />
    </Grid>
  </LayoutTransformControl>
</Window>
